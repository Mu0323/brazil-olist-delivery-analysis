      <column caption='州gmv排行' datatype='integer' name='[Calculation_1233686012076032]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(sum([商品GMV]))'>
          <table-calc ordering-type='Rows' />
