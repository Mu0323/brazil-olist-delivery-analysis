      <column caption='购买频次分组' datatype='string' name='[Calculation_1233686127661077]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1233686041751559] = 1 THEN &quot;1次（一次购）&quot;&#13;&#10;ELSEIF [Calculation_1233686041751559] = 2 THEN &quot;2次&quot;&#13;&#10;ELSEIF [Calculation_1233686041751559] = 3 THEN &quot;3次&quot;&#13;&#10;ELSE &quot;4次及以上&quot;&#13;&#10;END' />
