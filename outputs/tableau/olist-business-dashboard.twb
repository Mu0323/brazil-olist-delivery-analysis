      </column>
      <column caption='准时订单数' datatype='integer' name='[Calculation_1233686041157636]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF NOT ISNULL([实际送达时间])&#13;&#10;       AND [是否延误 (olist_order_facts_tableau.csv)] = 0&#13;&#10;    THEN [订单ID (olist_order_facts_tableau.csv)]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='已送达订单数' datatype='integer' name='[Calculation_1233686041370629]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF NOT ISNULL([实际送达时间])&#13;&#10;    THEN [订单ID (olist_order_facts_tableau.csv)]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='准时率' datatype='real' name='[Calculation_1233686041485318]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1233686041157636] / [Calculation_1233686041370629]' />
      </column>
      <column caption='客户订单数' datatype='integer' name='[Calculation_1233686041751559]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [真实客户ID] :&#13;&#10;    COUNTD([订单ID (olist_order_facts_tableau.csv)])&#13;&#10;}' />
      </column>
      <column caption='复购客户数' datatype='integer' name='[Calculation_1233686041808904]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Calculation_1233686041751559] &gt;= 2&#13;&#10;    THEN [真实客户ID]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='真实客户数' datatype='integer' name='[Calculation_1233686041858057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([真实客户ID])' />
      </column>
      <column caption='复购率' datatype='real' name='[Calculation_1233686042075146]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1233686041808904] / [Calculation_1233686041858057]' />
      </column>
      <column caption='好评订单数' datatype='integer' name='[Calculation_1233686043086859]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [评价分数 (olist_order_facts_tableau.csv)] &gt;= 4&#13;&#10;    THEN [订单ID (olist_order_facts_tableau.csv)]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='有评价订单数' datatype='integer' name='[Calculation_1233686043144204]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF NOT ISNULL([评价分数 (olist_order_facts_tableau.csv)])&#13;&#10;    THEN [订单ID (olist_order_facts_tableau.csv)]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='好评率' datatype='real' name='[Calculation_1233686043287565]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1233686043086859] / [Calculation_1233686043144204]' />
      </column>
      <column caption='box' datatype='string' name='[Calculation_1233686092333075]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
